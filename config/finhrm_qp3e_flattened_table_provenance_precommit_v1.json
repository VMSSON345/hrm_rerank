{
  "schema": "finhrm-qp3e-flattened-table-provenance-precommit-v1",
  "created_at": "2026-08-14",
  "classification": "development_only_synthetic_flattened_table_provenance_precommit",
  "status": "precommitted_before_qp3e_flattened_runtime_changes",
  "objective": "Permit construction of a full-table manifest from flattened native-text or OCR observations only when source boundaries, explicit role-bearing headers, row-cell coverage, physical order, geometry, and extractor provenance are independently complete and conflict-free.",
  "scope": {
    "in_scope": [
      "flattened native-text table blocks",
      "flattened OCR table blocks",
      "header-role cardinality",
      "declared data width and row-cell coverage",
      "source-line and page-order provenance",
      "column-band geometry",
      "repeated-header agreement",
      "cross-extractor structural agreement",
      "input-order invariance"
    ],
    "out_of_scope": [
      "runtime producer implementation",
      "EvidenceGraph acceptance",
      "question parsing",
      "program synthesis or ranking",
      "numeric answer accuracy",
      "threshold calibration",
      "global or sealed validation",
      "blind or test evaluation",
      "model fine-tuning",
      "real PDF replay"
    ]
  },
  "reconstruction_contract": {
    "output_states": ["RECONSTRUCTABLE_COMPLETE", "UNKNOWN"],
    "complete_requires_all": [
      "source boundary is COMPLETE and continuation state is CLOSED",
      "declared data-column IDs are non-empty and unique",
      "header observations cover exactly all declared data-column IDs",
      "header role cardinality equals declared data width",
      "every header has one explicit or anchored-inherited canonical role",
      "declared row IDs are non-empty and unique",
      "observed cell coordinates equal the Cartesian product of declared rows and data columns",
      "each cell belongs to exactly one row and one column",
      "header, row-descriptor, and cell observations have complete physical provenance",
      "header precedes its data cells in physical source order on each table segment",
      "cell column bands agree with the corresponding header column bands",
      "physical source spans do not map to conflicting logical cells",
      "repeated headers reproduce the same column-role map",
      "native/OCR observations do not disagree on boundaries, roles, rows, or columns",
      "the result is invariant to serialization order"
    ],
    "allowed_extraction_methods": [
      "synthetic_native_line",
      "synthetic_ocr_bbox",
      "synthetic_native_ocr_agreement"
    ],
    "allowed_role_confidence": ["EXPLICIT", "INHERITED"],
    "allowed_header_provenance": [
      "explicit_flattened_header",
      "inherited_flattened_header"
    ],
    "unknown_policy": "Failure or absence of any required proof produces UNKNOWN. UNKNOWN must not be promoted using Top-K candidates, question text, numeric value, answer, candidate score, rank, or input order.",
    "manifest_policy": "RECONSTRUCTABLE_COMPLETE permits only production of a structural manifest for the existing QP3D inventory audit. It does not directly produce EXPLICIT_COMPLETE, VALID, ACCEPT, or an answer.",
    "conflict_policy": "Any boundary, role, row-membership, physical-span, repeated-header, geometry, or cross-extractor conflict produces UNKNOWN and retains the conflict reason.",
    "numeric_policy": "Numeric cell values and answers are forbidden from the precommit cohort and reconstruction decision.",
    "ordering_policy": "Physical source order is proved by provenance sequence fields; JSON/list serialization order is never a signal."
  },
  "layout_specs": [
    {"id": "F01_NATIVE_SINGLE_PAGE", "roles": ["PLAN", "ACTUAL"], "rows": 3, "extractor": "synthetic_native_line", "layout": "native_single_page_flattened"},
    {"id": "F02_NATIVE_MULTI_PAGE", "roles": ["PRIOR_ACTUAL", "PLAN", "ACTUAL"], "rows": 4, "extractor": "synthetic_native_line", "layout": "native_multi_page_repeated_header"},
    {"id": "F03_OCR_BBOX", "roles": ["PLAN", "ACTUAL"], "rows": 3, "extractor": "synthetic_ocr_bbox", "layout": "ocr_bbox_flattened"},
    {"id": "F04_NATIVE_OCR_AGREE", "roles": ["ACTUAL", "FORECAST"], "rows": 2, "extractor": "synthetic_native_ocr_agreement", "layout": "native_ocr_agreeing_views"},
    {"id": "F05_MERGED_ROLE_HEADER", "roles": ["PRIOR_ACTUAL", "PLAN", "ACTUAL"], "rows": 3, "extractor": "synthetic_ocr_bbox", "layout": "merged_role_header_flattened"},
    {"id": "F06_BILINGUAL_HEADER", "roles": ["PLAN", "ACTUAL"], "rows": 2, "extractor": "synthetic_native_line", "layout": "bilingual_flattened_header"},
    {"id": "F07_REVISED_PLAN", "roles": ["PLAN", "REVISED_PLAN", "ACTUAL"], "rows": 3, "extractor": "synthetic_native_line", "layout": "revised_plan_flattened"},
    {"id": "F08_VALUE_RATIO", "roles": ["ACTUAL", "PLAN", "ACTUAL_TO_PLAN_RATIO", "ACTUAL_TO_PRIOR_RATIO"], "rows": 2, "extractor": "synthetic_ocr_bbox", "layout": "value_ratio_flattened"}
  ],
  "scenario_matrix": [
