  "hard_negative_taxonomy": [
    {"id": "HN_ROLE_SWAP", "mutation": "ACTUAL <-> PLAN while metric/year/entity/unit stay fixed", "expected": "original program INVALID or different typed program"},
    {"id": "HN_YEAR_SWAP", "mutation": "change exactly one operand year", "expected": "period proof rejects old assignment"},
    {"id": "HN_ENTITY_SCOPE", "mutation": "reporting/consolidated/separate/parent scope mismatch", "expected": "entity_scope_match INVALID"},
    {"id": "HN_UNIT_SCALE", "mutation": "same metric with incompatible unit or unproved scale", "expected": "unit proof INVALID or UNKNOWN and fail closed"},
    {"id": "HN_SAME_VALUE_DIFFERENT_IDENTITY", "mutation": "same numeric value at a different logical cell", "expected": "not accepted as grounded equivalent without provenance equivalence"},
    {"id": "HN_PERCENT_NEAR_ABSOLUTE", "mutation": "adjacent ratio/percent cell replaces absolute operand", "expected": "unit and column-role proof reject"},
    {"id": "HN_SUBTOTAL_DETAIL", "mutation": "subtotal/detail or liabilities/interest-bearing borrowings substitution", "expected": "metric/identity proof reject"},
    {"id": "HN_TABLE_SCOPE", "mutation": "confusable cell from another table or subtable", "expected": "table/entity proof reject unless cross-table identity is explicit"},
    {"id": "HN_COINCIDENTAL_EXECUTION", "mutation": "wrong operands produce the gold numeric result", "expected": "negative because provenance/program are wrong"},
    {"id": "HN_MISSING_QUALIFIER", "mutation": "remove role, direction, denominator or reference base", "expected": "ABSTAIN with the corresponding reason"}
  ],
  "annotation_schema": {
    "required_example_fields": [
      "example_id", "family_id", "question", "answerability", "answer_or_abstention",
      "program_dag", "operand_order", "reference_base", "hard_negative_type",
      "company_key", "report_id", "source_document_sha256", "annotator_status"
    ],
    "required_operand_fields": [
      "operand_id", "value", "metric", "period", "column_role", "entity_scope", "unit_scale",
      "logical_cell_id", "document_id", "page", "table_id", "row_id", "column_id",
      "source_span_or_coordinate", "evidence_state"
    ],
    "answerability_values": ["ANSWER", "ABSTAIN"],
    "annotator_status_values": ["single_reviewed_development", "double_reviewed", "adjudicated"],
    "test_requirement": "double_reviewed_and_adjudicated_on_disagreement",
    "numeric_equality_policy": "Decimal execution with explicit rounding/tolerance recorded per example",
    "coincidental_execution_policy": "wrong program or wrong provenance remains incorrect"
  },
  "split_protocol": {
    "group_key": "canonical_company_identity",
    "all_reports_of_company_in_one_partition": true,
    "partitions": ["development", "calibration", "sealed_test"],
    "target_company_proportions": {"development": 0.6, "calibration": 0.2, "sealed_test": 0.2},
    "assignment": "stable SHA-256 of canonical_company_identity with versioned salt",
    "assignment_salt_id": "finhrm-thesis-core-split-v1",
    "stratify_audit_by": ["family", "industry", "layout", "native_scan_hybrid", "year"],
    "no_company_overlap": true,
    "no_source_document_hash_overlap": true,
    "sealed_test_open_rule": "open once after code/config/checkpoint/threshold/calibration/report hashes are frozen",
    "sealed_test_threshold_selection_allowed": false,
    "previous_diagnosis_or_repair_companies_allowed_in_sealed_test": false,
    "minimum_thesis_target": {"examples": 300, "companies": 30},
    "paper_extension_target": {"examples_min": 800, "examples_max": 1200, "companies_min": 50}
  },
  "metrics": {
    "primary": [
      "provenance_correct_execution", "accepted_precision", "coverage", "hard_negative_false_accept_rate"
    ],
    "grounding": [
      "evidence_cell_recall_at_k", "operand_exact_match", "role_year_entity_unit_exact_match", "citation_cell_accuracy"
    ],
    "reasoning": [
      "program_dag_exact_match", "execution_accuracy", "verifier_gold_retention", "proof_state_confusion"
    ],
    "selective": [
      "risk_coverage_curve", "aurc", "brier_score_by_operation", "answerability_f1", "abstain_reason_accuracy"
    ],
    "efficiency": ["latency_p50", "latency_p95", "candidate_count", "pages_ranked"],
    "statistical_protocol": [
      "company_clustered_bootstrap_confidence_interval",
      "paired_bootstrap_or_mcnemar_on_same_test",
      "clopper_pearson_one_sided_lower_bound_for_accepted_precision",
      "macro_average_by_company_and_family"
    ],
    "ragas_role": "secondary_only"
