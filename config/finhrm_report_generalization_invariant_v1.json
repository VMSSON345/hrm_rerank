    "report_results_by_layout": true,
    "report_worst_group": true,
    "report_unseen_company_results": true,
    "report_unseen_layout_results": true,
    "safe_abstention_is_not_counted_as_answered": true,
    "universal_coverage_claim_allowed": false,
    "unsupported_layout_policy": "ABSTAIN_WITH_EXPLICIT_PROOF_OR_PROVENANCE_REASON"
  },
  "invariants": {
