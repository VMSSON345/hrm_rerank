    "logical_and_physical_cell_provenance",
    "table_structure_and_geometry",
    "extractor_agreement_or_conflict",
    "typed_program_and_proof_state"
  ],
  "repair_admission_rule": {
    "precommit_required": true,
    "diagnosis_documents_excluded_from_confirmation": true,
    "minimum_distinct_companies": 3,
    "minimum_distinct_layout_families": 3,
    "company_disjoint_from_diagnosis": true,
    "layout_disjoint_confirmation_required_when_repair_targets_layout": true,
    "positive_and_hard_negative_required": true,
    "counterfactual_required": true,
    "permutation_invariance_required": true,
    "no_regression_on_all_frozen_development_cohorts": true
