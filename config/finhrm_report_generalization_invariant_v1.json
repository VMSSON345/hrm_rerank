  "normative_statement": "One report-agnostic method must be applied unchanged to every report in the declared supported domain. A report outside that domain must fail closed or ABSTAIN; it must never trigger a report-specific repair.",
  "supported_domain_dimensions": [
    "company",
    "report",
    "year",
    "industry",
    "native_or_ocr_extraction",
    "table_layout",
    "question_surface",
    "metric",
    "numeric_value"
  ],
  "forbidden_runtime_signals": [
    "company_identity",
    "document_filename_or_hash",
    "fixed_page_number",
    "fixed_year",
    "fixed_numeric_value_or_answer",
    "single_question_literal",
    "example_or_family_id_used_as_runtime_rule",
    "candidate_rank_or_order_used_as_semantic_proof"
  ],
  "allowed_runtime_signals": [
    "typed_question_intent",
    "metric_semantics",
    "period_semantics",
    "column_role",
    "entity_scope",
