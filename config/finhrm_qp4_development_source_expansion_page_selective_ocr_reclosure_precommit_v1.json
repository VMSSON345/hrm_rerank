  "page_selection_contract": {
    "transform_id": "FINHRM_QP4_DEV_IMAGE_DOMINANT_PAGE_SELECTIVE_OCR_V1",
    "renderer": {
      "library": "PyMuPDF",
      "version": "1.28.0",
      "dpi": 96,
      "colorspace": "GRAY",
      "alpha": false
    },
    "raster_transform": {
      "binarization": "cv2.threshold(gray,0,255,THRESH_BINARY_INV+THRESH_OTSU)",
      "opencv_version": "5.0.0",
      "horizontal_kernel": "MORPH_RECT(max(12,round(width*0.035)),1)",
      "vertical_kernel": "MORPH_RECT(1,max(12,round(height*0.025)))",
      "morphology": "MORPH_OPEN",
      "horizontal_component": "bounding_width >= 0.08*page_width",
      "vertical_component": "bounding_height >= 0.06*page_height",
      "grid_candidate": "horizontal_count>=4 and vertical_count>=3 and intersection_components>=8",
      "row_band_candidate": "horizontal_count>=7 and horizontal_pixel_ratio>=0.006 and ink_ratio>=0.02",
      "candidate_range_filters": "0.02<=ink_ratio<=0.22 and horizontal_pixel_ratio<=0.18 and vertical_pixel_ratio<=0.18"
    },
    "structural_order": [
      "row_band_candidate descending",
      "grid_candidate descending",
      "horizontal_count descending",
      "vertical_count descending",
      "min(intersection_components,200) descending",
      "one_based_page ascending"
    ],
    "structural_pages_per_source": 4,
    "stratified_pages_per_source": 4,
    "stratified_formula": "for q in [1,2,3,4], one_based_page=1+floor((physical_pages-1)*q/5)",
    "merge": "set union; sort by one_based_page ascending; preserve both reasons on overlap",
    "maximum_selected_pages_per_source": 8,
    "neighbor_expansion_pages": 0,
    "fallback_replacement_after_ocr_outcome": false,
    "selector_role": "OCR routing only; raster metrics, ordering and page membership are never semantic proof or admission evidence"
