  "classification": "development_only_synthetic_table_provenance_precommit",
  "status": "precommitted_before_qp3c_runtime_producer_changes",
  "objective": "Permit EXPLICIT_COMPLETE only when table reconstruction proves complete role-bearing header and cell coverage with conflict-free physical provenance.",
  "scope": {
    "in_scope": [
      "table-level role inventory state",
      "header coverage",
      "cell-coordinate coverage",
      "merged-header inheritance anchors",
      "physical provenance completeness",
      "cross-extractor agreement",
      "candidate-order invariance"
    ],
    "out_of_scope": [
      "question parsing",
      "retrieval ranking",
      "numeric answer accuracy",
      "threshold calibration",
      "global or sealed validation",
      "blind or test evaluation",
      "model fine-tuning",
      "real PDF replay"
    ]
  },
  "producer_contract": {
    "output_states": ["EXPLICIT_COMPLETE", "UNKNOWN"],
    "complete_requires_all": [
      "table_boundary_state is COMPLETE",
      "header_alignment_state is ALIGNED",
      "expected data-column IDs are non-empty and exactly match reconstructed header-column IDs",
      "expected cell coordinates equal the complete Cartesian product of expected row IDs and expected data-column IDs",
      "observed cell coordinates exactly match expected cell coordinates",
      "every data column has one non-empty canonical role",
      "every role confidence is EXPLICIT or INHERITED",
      "every header-path element has allowed provenance",
      "every INHERITED role has a matching explicit inheritance anchor",
      "every observed cell has document/page/source-span/extraction-method provenance",
      "extractor alignment is not CONFLICT",
      "no header, cell, or physical-equivalence role conflict exists"
    ],
    "allowed_header_provenance": [
      "explicit_header",
      "inherited_merged_header",
      "explicit_column_label"
    ],
    "allowed_role_confidence": ["EXPLICIT", "INHERITED"],
    "unknown_policy": "Failure or absence of any required completeness proof produces UNKNOWN; the producer must never guess completeness from Top-K candidates, column order, numeric value, candidate score, or question text.",
    "conflict_policy": "Any explicit disagreement produces UNKNOWN at producer level; QP3B consumes the retained conflict evidence and safely abstains.",
    "permutation_policy": "Inventory state and reason set are invariant to header-column, cell-coordinate, and physical-observation ordering.",
    "numeric_policy": "Numeric values and answers are forbidden from the cohort and producer decision."
  },
  "layout_specs": [
    {"id": "L01_FLAT_PLAN_ACTUAL", "roles": ["PLAN", "ACTUAL"], "rows": 2, "layout": "flat_header"},
    {"id": "L02_HIERARCHICAL_MERGED", "roles": ["ACTUAL", "PLAN", "ACTUAL"], "rows": 2, "layout": "hierarchical_merged_header"},
    {"id": "L03_REPEATED_HEADER", "roles": ["PLAN", "ACTUAL"], "rows": 3, "layout": "repeated_header_after_page_break"},
    {"id": "L04_PARALLEL_ENTITY_PANELS", "roles": ["PLAN", "ACTUAL", "PLAN", "ACTUAL"], "rows": 2, "layout": "parallel_entity_panels"},
    {"id": "L05_REVISED_PLAN", "roles": ["PLAN", "REVISED_PLAN", "ACTUAL"], "rows": 2, "layout": "revised_plan_columns"},
    {"id": "L06_FORECAST", "roles": ["ACTUAL", "FORECAST"], "rows": 2, "layout": "actual_forecast_columns"},
    {"id": "L07_RATIO_COLUMNS", "roles": ["ACTUAL", "PLAN", "ACTUAL_TO_PLAN_RATIO", "ACTUAL_TO_PRIOR_RATIO"], "rows": 2, "layout": "value_and_ratio_columns"},
    {"id": "L08_BILINGUAL_HEADER", "roles": ["PLAN", "ACTUAL"], "rows": 2, "layout": "bilingual_role_aliases"}
  ],
